<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_usage_title"
        android:textColor="@color/widget_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_usage_initial_duration"
        android:textColor="@color/widget_text"
        android:textSize="26sp" />
    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_usage_initial_unlocks"
        android:textColor="@color/widget_brand"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:scaleType="fitXY" />
</LinearLayout>
